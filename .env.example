# Environment
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection
# Local example: mongodb://127.0.0.1:27017/sv-gym
# Atlas example: mongodb+srv://username:password@cluster0.mongodb.net/sv-gym?retryWrites=true&w=majority
MONGO_URI=<YOUR_MONGODB_URI>

# JWT Secrets (REQUIRED - Generate strong random strings)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=<YOUR_JWT_ACCESS_SECRET>
JWT_REFRESH_SECRET=<YOUR_JWT_REFRESH_SECRET>
JWT_QR_SECRET=<YOUR_JWT_QR_SECRET>

# JWT Token Expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# QR Code Check-in Configuration
QR_EXPIRES_SECONDS=60
CHECKIN_COOLDOWN_MINUTES=15

# Subscription Auto-Expire Job (milliseconds)
# Default: 60000 (1 minute). Adjust based on your needs.
SUBSCRIPTION_LIFECYCLE_INTERVAL_MS=60000

# VNPAY Payment Gateway (Get credentials from VNPAY merchant dashboard)
# Sandbox: https://sandbox.vnpayment.vn/apis/
# Production: https://vnpayment.vn/
VNP_TMNCODE=<YOUR_VNPAY_MERCHANT_CODE>
VNP_HASH_SECRET=<YOUR_VNPAY_HASH_SECRET>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=<YOUR_VNPAY_RETURN_URL>
VNP_IPN_URL=<YOUR_VNPAY_IPN_URL>

# Frontend Client URL (CORS origin and VNPAY redirect)
CLIENT_URL=<YOUR_FRONTEND_URL>
